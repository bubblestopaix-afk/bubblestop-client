{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/menu/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Paytone One|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Paytone One, Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|fg|star|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, color, fg, star, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|soft|outline)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|href|as|type|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, href, as, type, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|accent|interactive|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: surface, accent, interactive, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|plain)$/]",
        "message": "<Card> surface must be one of 'paper' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryPrice'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|price|label|color|key|ref|className|style|children)$/]",
        "message": "<CategoryPrice> doesn't accept that prop. Declared props: size, price, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|variant|strokeWidth|style|className|key|ref|className|style|children)$/]",
        "message": "<Sparkle> doesn't accept that prop. Declared props: size, color, variant, strokeWidth, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkle'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Sparkle> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|columns|key|ref|className|style|children)$/]",
        "message": "<FlavorGroup> doesn't accept that prop. Declared props: label, items, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|src|height|tagline|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, src, height, tagline, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|white)$/]",
        "message": "<Logo> variant must be one of 'ink' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|recipe|price|size|label|cold|accent|children|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: name, recipe, price, size, label, cold, accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|price|label|color|small|key|ref|className|style|children)$/]",
        "message": "<PricePill> doesn't accept that prop. Declared props: size, price, label, color, small."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|vol|h|key|ref|className|style|children)$/]",
        "message": "<SizeOption> doesn't accept that prop. Declared props: id, vol, h."
      },
      {
        "selector": "JSXOpeningElement[name.name='SugarOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|amount|key|ref|className|style|children)$/]",
        "message": "<SugarOption> doesn't accept that prop. Declared props: id, label, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToppingChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|dot|dotColor|selectable|selected|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<ToppingChip> doesn't accept that prop. Declared props: children, label, dot, dotColor, selectable, selected, onClick, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
